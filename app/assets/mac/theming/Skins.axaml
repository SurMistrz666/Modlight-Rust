<!-- The app's own skin, Graphite: deep neutrals, thin borders and a blue accent. Read by
     modlight-core/build.rs with upstream's skins (same keys) and listed first. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:ShareX.Avalonia.Helpers">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="{x:Static helpers:SkinVariants.Graphite_Dark}">
            <Color x:Key="ShareX.Color.Accent.Start">#3B82F6</Color>
            <Color x:Key="ShareX.Color.Accent.End">#2563EB</Color>
            <Color x:Key="ShareX.Color.Accent.Foreground">#FFFFFF</Color>
            <Color x:Key="ShareX.Color.Skin.Accent">#3B82F6</Color>
            <Color x:Key="ShareX.Color.Skin.Accent.Foreground">#FFFFFF</Color>
            <Color x:Key="ShareX.Color.Text">#EDEDED</Color>
            <Color x:Key="ShareX.Color.Text.Secondary">#A1A1A1</Color>
            <Color x:Key="ShareX.Color.Text.OnPanel">#EDEDED</Color>
            <Color x:Key="ShareX.Color.Text.Secondary.OnPanel">#A1A1A1</Color>
            <Color x:Key="ShareX.Color.Focus">#3B82F6</Color>
            <Color x:Key="ShareX.Color.Focus.OnPanel">#3B82F6</Color>
            <Color x:Key="ShareX.Color.Background.Main">#0A0A0A</Color>
            <Color x:Key="ShareX.Color.Background.Panel">#121212</Color>
            <Color x:Key="ShareX.Color.Background.Popup">#171717</Color>
            <Color x:Key="ShareX.Color.Background.Menu">#171717</Color>
            <Color x:Key="ShareX.Color.Background.Toolbar">#0F0F0F</Color>
            <Color x:Key="ShareX.Color.Border">#262626</Color>
            <Color x:Key="ShareX.Color.Control.Background">#171717</Color>
            <Color x:Key="ShareX.Color.Control.Background.Hover">#1F1F1F</Color>
            <Color x:Key="ShareX.Color.Control.Background.Disabled">#1A1A1A</Color>
            <Color x:Key="ShareX.Color.Control.Border">#262626</Color>
            <Color x:Key="ShareX.Color.Separator">#262626</Color>
            <Color x:Key="ShareX.Color.TaskMode.Cancel.Background">#DC2626</Color>
            <Color x:Key="ShareX.Color.TaskMode.Cancel.Border">#F87171</Color>
            <Color x:Key="ShareX.Color.TaskMode.Continue.Background">#16A34A</Color>
            <Color x:Key="ShareX.Color.TaskMode.Continue.Background.Hover">#15803D</Color>
            <Color x:Key="ShareX.Color.TaskMode.Continue.Border">#4ADE80</Color>
            <Color x:Key="ShareX.Color.TaskMode.Foreground">#FFFFFF</Color>
            <Color x:Key="ShareX.Color.Checker.A">#171717</Color>
            <Color x:Key="ShareX.Color.Checker.B">#262626</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="{x:Static helpers:SkinVariants.Graphite_Light}">
            <Color x:Key="ShareX.Color.Accent.Start">#2563EB</Color>
            <Color x:Key="ShareX.Color.Accent.End">#1D4ED8</Color>
            <Color x:Key="ShareX.Color.Accent.Foreground">#FFFFFF</Color>
            <Color x:Key="ShareX.Color.Skin.Accent">#2563EB</Color>
            <Color x:Key="ShareX.Color.Skin.Accent.Foreground">#FFFFFF</Color>
            <Color x:Key="ShareX.Color.Text">#171717</Color>
            <Color x:Key="ShareX.Color.Text.Secondary">#55555C</Color>
            <Color x:Key="ShareX.Color.Text.OnPanel">#171717</Color>
            <Color x:Key="ShareX.Color.Text.Secondary.OnPanel">#55555C</Color>
            <Color x:Key="ShareX.Color.Focus">#2563EB</Color>
            <Color x:Key="ShareX.Color.Focus.OnPanel">#2563EB</Color>
            <Color x:Key="ShareX.Color.Background.Main">#FAFAFA</Color>
            <Color x:Key="ShareX.Color.Background.Panel">#FFFFFF</Color>
            <Color x:Key="ShareX.Color.Background.Popup">#FFFFFF</Color>
            <Color x:Key="ShareX.Color.Background.Menu">#FFFFFF</Color>
            <Color x:Key="ShareX.Color.Background.Toolbar">#F4F4F5</Color>
            <Color x:Key="ShareX.Color.Border">#E4E4E7</Color>
            <Color x:Key="ShareX.Color.Control.Background">#FFFFFF</Color>
            <Color x:Key="ShareX.Color.Control.Background.Hover">#F4F4F5</Color>
            <Color x:Key="ShareX.Color.Control.Background.Disabled">#EFEFF1</Color>
            <Color x:Key="ShareX.Color.Control.Border">#E4E4E7</Color>
            <Color x:Key="ShareX.Color.Separator">#E4E4E7</Color>
            <Color x:Key="ShareX.Color.TaskMode.Cancel.Background">#DC2626</Color>
            <Color x:Key="ShareX.Color.TaskMode.Cancel.Border">#EF4444</Color>
            <Color x:Key="ShareX.Color.TaskMode.Continue.Background">#16A34A</Color>
            <Color x:Key="ShareX.Color.TaskMode.Continue.Background.Hover">#15803D</Color>
            <Color x:Key="ShareX.Color.TaskMode.Continue.Border">#22C55E</Color>
            <Color x:Key="ShareX.Color.TaskMode.Foreground">#FFFFFF</Color>
            <Color x:Key="ShareX.Color.Checker.A">#F4F4F5</Color>
            <Color x:Key="ShareX.Color.Checker.B">#E4E4E7</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
