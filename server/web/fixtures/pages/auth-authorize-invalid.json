{
  "url": "/authorize",
  "payload": {
    "route": "/(auth)/authorize",
    "params": {},
    "layouts": "$auth",
    "props": {
      "parsed": {
        "ok": false,
        "reason": "invalid-port"
      },
      "session": null
    },
    "meta": {
      "title": "Connect an app - Modlight",
      "tags": [
        {
          "tag": "meta",
          "attrs": {
            "name": "description",
            "content": "Fast, modern, self-hosted file & screenshot sharing with rock-solid large-file uploads and first-class ShareX support."
          }
        },
        {
          "tag": "meta",
          "attrs": {
            "name": "application-name",
            "content": "Modlight"
          }
        }
      ]
    }
  }
}
