{
  "url": "/login",
  "payload": {
    "route": "/(auth)/login",
    "params": {},
    "layouts": "$auth",
    "props": {
      "registration": {
        "open": true
      }
    },
    "meta": {
      "title": "Sign in - Modlight",
      "tags": [
        {
          "tag": "meta",
          "attrs": {
            "name": "description",
            "content": "Fast, modern, self-hosted file & screenshot sharing with rock-solid large-file uploads and first-class ShareX support."
          }
        },
        {
          "tag": "meta",
          "attrs": {
            "name": "application-name",
            "content": "Modlight"
          }
        }
      ]
    }
  }
}
