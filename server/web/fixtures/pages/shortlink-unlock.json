{
  "url": "/s/promo/unlock",
  "payload": {
    "route": "/s/[code]/unlock",
    "params": {
      "code": "promo"
    },
    "layouts": "$root",
    "props": {
      "code": "promo",
      "ownerTheme": "terminal",
      "background": null
    },
    "meta": {
      "title": "Protected link - Modlight",
      "tags": [
        {
          "tag": "meta",
          "attrs": {
            "name": "description",
            "content": "Fast, modern, self-hosted file & screenshot sharing with rock-solid large-file uploads and first-class ShareX support."
          }
        },
        {
          "tag": "meta",
          "attrs": {
            "name": "application-name",
            "content": "Modlight"
          }
        }
      ]
    }
  }
}
