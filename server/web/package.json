{
  "name": "modlight-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Modlight web panel as a client-side SPA served by the Rust server (see ../docs/CONTRACT.md).",
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "vite --mode fixtures",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "sync:check": "node scripts/sync-upstream.mjs --check",
    "gen:actions": "node scripts/gen-actions.mjs",
    "audit:bundle": "node scripts/audit-bundle.mjs",
    "size": "node scripts/size-report.mjs"
  },
  "dependencies": {
    "@uppy/core": "^5.2.0",
    "@uppy/dashboard": "^5.1.1",
    "@uppy/react": "^5.2.0",
    "@uppy/tus": "^5.1.1",
    "better-auth": "^1.6.13",
    "blurhash": "^2.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.17.0",
    "media-chrome": "^4.19.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "7.18.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-intl": "4.13.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "shadcn": "^4.10.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.0.16",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@10.33.0"
}
